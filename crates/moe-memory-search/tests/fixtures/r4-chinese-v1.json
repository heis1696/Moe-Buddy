  "labels": "固定合成中文人工相关性标签；3=直接相关；未列出=不相关。不是模型判分。",
  "records": [
    {
      "id": "p01",
      "scope": "private",
      "text": "每天傍晚我都泡一壶茉莉花茶。"
    },
    {
      "id": "p02",
      "scope": "private",
      "text": "点面时我总会请店家不要放香菜。"
    },
    {
      "id": "p03",
      "scope": "private",
      "text": "我的生日是九月十七日。"
    },
    {
      "id": "p04",
      "scope": "private",
      "text": "我家的橘猫叫团子。"
    },
    {
      "id": "p05",
      "scope": "private",
      "text": "我把备用钥匙放在玄关蓝色盒子里。"
    },
    {
      "id": "p06",
      "scope": "private",
      "text": "我通常晚上十一点半上床睡觉。"
    },
    {
      "id": "p07",
      "scope": "private",
      "text": "我对花生过敏，买零食会先检查配料。"
    },
    {
      "id": "p08",
      "scope": "private",
      "text": "我周六上午去河边慢跑。"
    },
    {
      "id": "p09",
      "scope": "private",
      "text": "读书时我习惯播放没有人声的钢琴曲。"
    },
    {
      "id": "p10",
      "scope": "private",
      "text": "我的围巾喜欢选深绿色。"
    },
    {
      "id": "p11",
      "scope": "private",
      "text": "我去年夏天在青岛看过海。"
    },
    {
      "id": "p12",
      "scope": "private",
      "text": "我出门旅行更愿意坐火车而不是飞机。"
    },
    {
      "id": "p13",
      "scope": "private",
      "text": "心情低落时我希望先被安静陪着，不急着听建议。"
    },
    {
      "id": "p14",
      "scope": "private",
      "text": "我养的薄荷每隔两天浇一次水。"
    },
    {
      "id": "p15",
      "scope": "private",
      "text": "我正在学习用陶轮制作杯子。"
    },
    {
      "id": "p16",
      "scope": "private",
      "text": "我喜欢把周计划写在纸质手账上。"
    },
    {
      "id": "s01",
      "scope": "shared",
      "text": "图书馆周一闭馆，周二至周日开放。"
    },
    {
      "id": "s02",
      "scope": "shared",
      "text": "银杏树的叶片像小扇子，秋天会变黄。"
    },
    {
      "id": "s03",
      "scope": "shared",
      "text": "冲泡绿茶宜用八十摄氏度左右的水。"
    },
    {
      "id": "s04",
      "scope": "shared",
      "text": "小苏打溶液可去除杯子内壁的茶渍。"
    },
    {
      "id": "s05",
      "scope": "shared",
      "text": "社区旧电池回收箱位于北门门卫室。"
    },
    {
      "id": "s06",
      "scope": "shared",
      "text": "番茄苗需要充足日照并保持盆土排水通畅。"
    },
    {
      "id": "s07",
      "scope": "shared",
      "text": "食物冷藏时应把熟食放在生肉上层。"
    },
    {
      "id": "s08",
      "scope": "shared",
      "text": "自行车链条清洁后应擦干并添加润滑油。"
    },
    {
      "id": "s09",
      "scope": "shared",
      "text": "遇到雷电应离开孤立大树并进入封闭建筑。"
    },
    {
      "id": "s10",
      "scope": "shared",
      "text": "室内发现燃气泄漏时不要开关电器，应通风并到室外报警。"
    },
    {
      "id": "s11",
      "scope": "shared",
      "text": "捐赠衣物前应清洗晾干，并确认没有破损。"
    },
    {
      "id": "s12",
      "scope": "shared",
      "text": "修补图书破页宜用无酸修补纸，避免普通胶带老化。"
    },
    {
      "id": "s13",
      "scope": "formal",
      "text": "受信协议规定：发送前必须核对目的端点与用途许可。"
    },
    {
      "id": "s14",
      "scope": "formal",
      "text": "能力说明规定：搜索结果不授予工具执行权限。"
    },
    {
      "id": "s15",
      "scope": "formal",
      "text": "审计协议规定：未知传输结果不得登记为成功。"
    },
    {
      "id": "s16",
      "scope": "formal",
      "text": "删除协议规定：本地移除不能召回已经交付的外部副本。"
    }
  ],
